# Porta em que o servidor Express escuta
PORT=3000

# Obrigatória. Endereço secreto no formato iCal do Google Agenda.
#
# Onde obter: Google Agenda → engrenagem (Configurações) → escolher a agenda na
# coluna da esquerda → "Integrar agenda" → copiar o campo
# "Endereço secreto no formato iCal" (termina em /basic.ics).
#
# ATENÇÃO — é credencial ao portador: quem tiver o endereço lê a agenda
# inteira, sem autenticação e por tempo indeterminado. Por isso:
#   - nunca versione o valor real (o .env está no .gitignore);
#   - nunca use o "Endereço público", que exigiria tornar a agenda pública;
#   - se vazar, use "Redefinir" na mesma tela do Google para invalidá-lo.
#
# Sem esta variável, /api/calendar responde 500 em vez de servir outro
# calendário.
#
# Formato:
# CALENDAR_ICS_URL=https://calendar.google.com/calendar/ical/SEU_EMAIL%40gmail.com/private-TOKEN/basic.ics
CALENDAR_ICS_URL=

# Origem autorizada a consumir /api/calendar (defina o domínio de produção)
ALLOWED_ORIGIN=http://localhost:3000

# Tempo de cache em memória do endpoint /api/calendar, em milissegundos
CACHE_TTL_MS=300000
