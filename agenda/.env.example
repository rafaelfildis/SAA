# Porta em que o servidor Express escuta
PORT=3000

# OPCIONAL. Sobrepõe o endereço padrão do calendário definido no código
# (server.js / api/calendar.js).
#
# O padrão é o ENDEREÇO PÚBLICO no formato iCal da agenda, que só responde
# enquanto ela estiver marcada como pública no Google Agenda, em
# "Permissões de acesso a eventos" → "Tornar disponível ao público", com
# "Ver todos os detalhes do evento" (a opção "Ver apenas livre/ocupado"
# entrega horários sem título, local ou participantes).
#
# Use esta variável quando a agenda for privada: aponte-a para o ENDEREÇO
# SECRETO, obtido em Configurações da agenda → Integrar agenda →
# "Endereço secreto no formato iCal".
#
# ATENÇÃO — o endereço secreto é credencial ao portador: quem o tiver lê a
# agenda inteira, sem autenticação e por tempo indeterminado. Nunca o
# comite (este repositório é público); mantenha-o só aqui, no .env, que está
# no .gitignore, e nas variáveis de ambiente da implantação. Se vazar, use
# "Redefinir" na mesma tela do Google para invalidá-lo.
#
# CALENDAR_ICS_URL=https://calendar.google.com/calendar/ical/SEU_EMAIL%40gmail.com/private-TOKEN/basic.ics
CALENDAR_ICS_URL=

# Origem autorizada a consumir /api/calendar (defina o domínio de produção)
ALLOWED_ORIGIN=http://localhost:3000

# Tempo de cache em memória do endpoint /api/calendar, em milissegundos
CACHE_TTL_MS=300000
