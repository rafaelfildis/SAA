# Porta em que o servidor Express escuta
PORT=3000

# Obrigatória. URL pública do calendário ICS publicado no Outlook/Microsoft 365
# do TCM-BA. Sem ela, /api/calendar responde 500 em vez de servir outro
# calendário. Obtida em: Outlook Web → Calendário → Compartilhar → Publicar →
# copiar o link no formato ICS.
CALENDAR_ICS_URL=

# Origem autorizada a consumir /api/calendar (defina o domínio de produção)
ALLOWED_ORIGIN=http://localhost:3000

# Tempo de cache em memória do endpoint /api/calendar, em milissegundos
CACHE_TTL_MS=300000
